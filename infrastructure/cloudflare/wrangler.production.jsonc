{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextf-cms-api",
  "account_id": "df47917ecc2d22a3612202862f42fb38",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "cms-api.nextf.lk",
      "custom_domain": true
    },
    {
      "pattern": "media.nextf.lk",
      "custom_domain": true
    },
    {
      "pattern": "tracking.nextf.lk",
      "custom_domain": true
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "CMS_ORIGIN": "https://cms.nextf.lk",
    "WORKSPACE_ORIGIN": "https://workspace.nextf.lk",
    "PUBLIC_SITE_ORIGIN": "https://nextf.lk",
    "ACCESS_TEAM_DOMAIN": "PENDING_NEW_ACCOUNT_ACCESS_TEAM_DOMAIN",
    "ACCESS_AUD": "PENDING_NEW_ACCOUNT_ACCESS_AUD",
    "CONTRACTS_BASE_URL": "https://contracts.nextf.lk",
    "CHECKOUT_API_ORIGIN": "https://checkout-api.nextf.lk",
    "CHECKOUT_CONTRACT_RELEASE": "1.0.0",
    "MEDIA_ORIGIN": "https://media.nextf.lk",
    "TRACKING_SITE_ID": "site_nextf_main",
    "TRACKING_PROPERTY_ROUTING_ENABLED": "false",
    "TRACKING_ORGANIZATION_ID": "org_nextf",
    "TRACKING_ALLOWED_ORIGINS": "https://nextf.lk",
    "TRACKING_EVENT_KEYS": "page.viewed,cta.clicked,form.started,form.submitted",
    "TRACKING_CONTRACT_VERSION": "1.4.0",
    "TRACKING_ENVELOPE_VERSIONS": "1.0.0",
    "TRACKING_SDK_VERSIONS": "1.0.0",
    "AUDIT_RETENTION_DAYS": "365",
    "OUTBOX_RETENTION_DAYS": "90"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nextf-cms-production",
      "database_id": "0784f4cf-85c1-4fe5-9f4f-b4c3af11f13e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "nextf-cms-production-files"
    },
    {
      "binding": "MEDIA",
      "bucket_name": "nextf-media-production"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS",
        "queue": "nextf-cms-production-events"
      },
      {
        "binding": "TRACKING_EVENTS",
        "queue": "nextf-tracking-production-events"
      }
    ],
    "consumers": [
      {
        "queue": "nextf-cms-production-events",
        "dead_letter_queue": "nextf-cms-production-events-dlq",
        "max_retries": 3
      },
      {
        "queue": "nextf-tracking-production-events",
        "dead_letter_queue": "nextf-tracking-production-events-dlq",
        "max_batch_size": 20,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "analytics_engine_datasets": [
    {
      "binding": "TRACKING_ANALYTICS",
      "dataset": "nextf_tracking_production"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "15 * * * *"
    ]
  },
  "secrets": {
    "required": [
      "CHECKOUT_ADMIN_TOKEN",
      "CHECKOUT_SECRET_ADMIN_TOKEN",
      "NEXTF_MAIN_SITE_INGEST_TOKEN",
      "GAMING_SUMMARY_INGEST_TOKEN",
      "SERVICE_CREDENTIAL_SECRET",
      "TRACKING_SERVER_TOKEN",
      "TURNSTILE_SECRET_KEY"
    ]
  }
}
