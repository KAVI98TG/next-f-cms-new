{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextf-cms-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "staging",
    "CMS_ORIGIN": "https://cms.nextf.lk",
    "WORKSPACE_ORIGIN": "https://workspace.nextf.lk",
    "PUBLIC_SITE_ORIGIN": "https://nextf.lk",
    "ACCESS_TEAM_DOMAIN": "YOUR_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "SET_IN_ENVIRONMENT_SPECIFIC_CONFIG",
    "CONTRACTS_BASE_URL": "https://contracts.nextf.lk",
    "GAMING_API_ORIGIN": "https://gaming-api.nextf.lk",
    "AUDIT_RETENTION_DAYS": "365",
    "OUTBOX_RETENTION_DAYS": "90"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "nextf-cms-staging", "database_id": "REPLACE_ME", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "nextf-cms-staging-files" }],
  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "nextf-cms-staging-events" }],
    "consumers": [{ "queue": "nextf-cms-staging-events", "dead_letter_queue": "nextf-cms-staging-events-dlq", "max_retries": 3 }]
  },
  "ratelimits": [{ "name": "PUBLIC_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "triggers": { "crons": ["15 * * * *"] }
}
